# Server Configuration
PORT=5000

# MongoDB Connection
# Primary URI (direct MongoDB connection for replica sets)
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=replicaset-name&authSource=admin&appName=YourApp

# Fallback URI (SRV record format, used if primary fails)
MONGODB_URI_DIRECT=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# Database name (avoid spaces, use underscores instead: MyApp_DB not MyApp DB)
MONGODB_DB_NAME=MathswithSD_DB

# MongoDB Connection Pool Settings (optional, defaults provided)
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=2000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google Gemini API (for AI features)
GEMINI_API_KEY=your_google_gemini_api_key

# Seed Teacher Configuration (for initial admin account setup)
SEED_TEACHER_PHONE=6289855545
SEED_TEACHER_PASSWORD=your_secure_password
SEED_TEACHER_FIRST_NAME=Admin
SEED_TEACHER_LAST_NAME=Teacher
SEED_TEACHER_EMAIL=admin@mathswithsd.local

# Environment
NODE_ENV=development
